# shellcheck shell=bash
# BashCutPro's product name, release file prefix and icons for the packaging scripts. Sourced by
# packaging/env.sh (needs ROOT); the upstream files that use these are listed in bashcut/rebrand.md.
# Binaries, crates and file formats keep their filmcraft names (the data folder is BashCutPro's, see bashcut/rebrand.md).
# BRAND_ICON_DIR's hicolor icons keep upstream's file names; the Linux packages ship them as com.birchapps.bashcutpro.*
# (the generated copy's app id, SB4: bashcut/packaging/README.md).
# Every variable here: bashcut/scripts/README.md.
export BRAND_NAME="${BRAND_NAME:-BashCutPro}"
export BRAND_SLUG="${BRAND_SLUG:-bashcutpro}"
export BRAND_ICON_DIR="${BRAND_ICON_DIR:-$ROOT/bashcut/brand/app-icon}"

# BashCutPro Pro pieces in the installers (#64, bashcut/packaging/README.md): the first time a packaging script sources
# this file, write a copy of packaging/ with our additions (bashcut/packaging/generate.py) and run the same script from
# that copy instead. BASHCUT_PACKAGING_PLAIN=1 packages upstream's files as they are.
if [ -z "${BASHCUT_BRANDED:-}" ] && [ "${BASHCUT_PACKAGING_PLAIN:-0}" != 1 ]; then
  _bc_top="${BASH_SOURCE[${#BASH_SOURCE[@]}-1]}"
  _bc_top="$(cd "$(dirname "$_bc_top")" && pwd)/$(basename "$_bc_top")"
  case "$_bc_top" in
    "$ROOT/packaging/"*)
      export BASHCUT_PACKAGING="${CARGO_TARGET_DIR:-$ROOT/target}/bashcut-packaging"
      # shellcheck source=bashcut/scripts/python.sh
      . "$ROOT/bashcut/scripts/python.sh"
      _bc_py="$(bashcut_python)" || exit 1
      # shellcheck disable=SC2086 # $_bc_py may be "py -3"
      $_bc_py "$ROOT/bashcut/packaging/generate.py" --root "$ROOT" --out "$BASHCUT_PACKAGING" || exit 1
      export BASHCUT_BRANDED=1 BASHCUT_ROOT="$ROOT"
      exec bash "$BASHCUT_PACKAGING/${_bc_top#"$ROOT/packaging/"}" "$@"
      ;;
  esac
  unset _bc_top
fi
